{
  "buildCommand": "cd apps/web && npm install && npm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path=/api/$1"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py?__path=/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py?__path=/openapi.json"
    },
    {
      "source": "/redoc",
      "destination": "/api/index.py?__path=/redoc"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
