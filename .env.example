# ==============================================================================
# SIGNAL 📡 — Environment Configuration
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_NAME=SIGNAL
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Authentication & Security
# IMPORTANT: Generate a unique secret for production (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=<generate-a-unique-secret-at-least-32-chars>
SECRET_KEY=<generate-a-unique-secret-at-least-32-chars>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Database Configuration
# Default is SQLite for fast local development out-of-the-box.
# For production PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/signal_db
DATABASE_URL=sqlite+aiosqlite:///./signal_dev.db
DATABASE_ECHO=False

# AI Provider Gateway Configuration
# Supported providers: mock, nvidia, gemini, openai
AI_PRIMARY_PROVIDER=mock
AI_SECONDARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openai

# Task-specific routing overrides
AI_ROUTING_CLASSIFICATION=mock
AI_ROUTING_EXTRACTION=mock
AI_ROUTING_SUMMARIZATION=mock

# AI Provider API Keys (leave empty or set appropriately)
NVIDIA_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Notification Configuration
# Provider options: mock, telegram, discord, email, in_app
SIGNAL_NOTIFICATION_PROVIDER=mock
SIGNAL_DEFAULT_MIN_RELEVANCE_SCORE=70
SIGNAL_DEFAULT_DAILY_NOTIFICATION_LIMIT=10
SIGNAL_CRITICAL_ALERT_BYPASS_QUIET_HOURS=True
SIGNAL_CRITICAL_ALERT_BYPASS_RATE_LIMIT=True

# Telegram Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Discord Configuration
DISCORD_WEBHOOK_URL=

# Email / SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@signal.dev
SMTP_USE_TLS=True

# Worker / Ingestion Frequency (in seconds)
INGESTION_DEFAULT_INTERVAL=300
